# Caddyfile für das Network Portal (Caddy 2 + PHP-FPM).
#
# Anpassen: Domain, "root" und ggf. den php_fastcgi-Socket. Danach:
#   sudo systemctl reload caddy
#
# WebAuthn (YubiKey im Browser) verlangt HTTPS – Caddy holt das Zertifikat
# automatisch. Für reine Intranet-Namen: "tls internal" ergänzen.

netz.example.com {
	root * /var/www/netportal
	encode zstd gzip

	# Dateien in assets/ tragen eine Inhalts-Kennung (?v=…) – dauerhaft zwischenspeichern
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	route {
		# Diese Ordner/Dateien dürfen nie direkt abrufbar sein – alles läuft über index.php
		@gesperrt path */config/* */database/* */includes/* */bin/* */pam-helper/* */server/* */system/* */icons/* */.cache/* */docs/* */demo/* */manifest.sha256 */README.md */CHANGELOG.md */LICENSE */router.php */install.sh */.user.ini */.htaccess
		respond @gesperrt 403

		php_fastcgi unix//run/php/php8.5-fpm.sock

		file_server {
			hide .*
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
		-X-Powered-By
	}
}
